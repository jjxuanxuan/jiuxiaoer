# 应用服务模块：运行环境、进程时区和 HTTP 监听地址。
JXE_APP_ENV=local
TZ=Asia/Shanghai
JXE_HTTP_ADDR=:8080

# MySQL 数据库模块：API 使用低权限 DSN，迁移和 Seed 使用高权限 DSN。
# 酒票模块要求运行 DSN 包含 parseTime=True&loc=Local，并使用 +08:00 时区。
JXE_MYSQL_DSN='jxe_app:p0apppass@tcp(127.0.0.1:13306)/jiuxiaoer_go_p0?charset=utf8mb4&parseTime=True&loc=Local'
JXE_MYSQL_MIGRATION_DSN='jxe:p0devpass@tcp(127.0.0.1:13306)/jiuxiaoer_go_p0?charset=utf8mb4&parseTime=True&loc=Local'
JXE_MYSQL_REQUIRED=true
JXE_MYSQL_REQUIRED_TIME_ZONE=+08:00

# Redis 缓存模块：本地 Redis 无密码时 JXE_REDIS_PASSWORD 保持为空。
JXE_REDIS_ADDR=127.0.0.1:16379
JXE_REDIS_PASSWORD=
JXE_REDIS_DB=0
JXE_REDIS_REQUIRED=true

# RabbitMQ 消息队列模块：不使用 MQ 时可将 JXE_RABBITMQ_REQUIRED 设为 false。
JXE_RABBITMQ_URL=amqp://jxe:p0devpass@127.0.0.1:5672/jxe-events-v2
JXE_RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672/api
JXE_RABBITMQ_REQUIRED=true

# JWT 鉴权模块：生产环境必须替换为两个不同且不少于 32 字符的随机密钥。
JXE_JWT_ACCESS_SECRET=local_access_secret_change_me
JXE_JWT_REFRESH_SECRET=local_refresh_secret_change_me
JXE_JWT_ACCESS_TTL=2h
JXE_JWT_REFRESH_TTL=168h

# 普通订单支付超时模块：酒票购买、续期和退款资金链路也依赖过期任务。
JXE_ORDER_PAYMENT_TTL=15m
JXE_ORDER_EXPIRY_WORKER_ENABLED=true
JXE_ORDER_EXPIRY_SCAN_INTERVAL=10s
JXE_ORDER_EXPIRY_BATCH_SIZE=100

# 常购清单与一键复购模块：按已完成订单聚合，并限制单次批量复购数量。
JXE_REPURCHASE_ENABLED=true
JXE_REPURCHASE_LOOKBACK_DAYS=180
JXE_REPURCHASE_MAX_ITEMS=20

# 微信小程序认证模块：本地 Mock 不需要 Secret；真实登录和酒票微信提醒必须填写 AppID 和 Secret。
JXE_WECHAT_AUTH_ENABLED=true
JXE_WECHAT_AUTH_MOCK_ENABLED=true
JXE_WECHAT_MINIAPP_ID=local-miniapp
JXE_WECHAT_MINIAPP_SECRET=
JXE_WECHAT_API_BASE_URL=https://api.weixin.qq.com
JXE_WECHAT_HTTP_TIMEOUT=5s

# 微信支付 APIv3 模块：本地默认使用 Mock；生产环境必须关闭 Mock 并填写商户 APIv3 凭据及回调地址。
JXE_WECHAT_PAY_ENABLED=true
JXE_WECHAT_PAY_MOCK_ENABLED=true
JXE_WECHAT_PAY_MCH_ID=
JXE_WECHAT_PAY_CERT_SERIAL=
JXE_WECHAT_PAY_PRIVATE_KEY_PATH=
JXE_WECHAT_PAY_API_V3_KEY=
JXE_WECHAT_PAY_NOTIFY_URL=
JXE_WECHAT_REFUND_NOTIFY_URL=
# 微信支付公钥验签配置必须成对填写；生产酒票资金链路必须填写。
JXE_WECHAT_PAY_PUBLIC_KEY_ID=
JXE_WECHAT_PAY_PUBLIC_KEY_PATH=

# 微信支付账单对账模块：生产微信支付必须开启，并将开始日期填写为 YYYY-MM-DD。
JXE_WECHAT_BILL_RECONCILIATION_ENABLED=false
JXE_WECHAT_BILL_RECONCILIATION_WORKER_ENABLED=true
JXE_WECHAT_BILL_RECONCILIATION_START_DATE=

# 初始化账号模块：仅供本地 Seed；生产环境必须替换默认密码。
JXE_ADMIN_BOOTSTRAP_PASSWORD=admin123
JXE_MERCHANT_BOOTSTRAP_PASSWORD=merchant123
JXE_RIDER_BOOTSTRAP_PASSWORD=rider123

# 订单基础能力模块：酒票购买、续期和退款必须开启支付、幂等与库存保护。
JXE_PAYMENT_MOCK_ENABLED=true
JXE_ORDER_IDEMPOTENCY_ENABLED=true
JXE_STOCK_RESERVE_ENABLED=true

# MQ 发布与消费模块：按部署角色开启相应发布者和消费者。
JXE_MQ_PUBLISHER_ENABLED=false
JXE_MQ_PUBLISH_ENABLED=false
JXE_MQ_TOPOLOGY_VERSION=v1
JXE_MQ_PUBLISHER_BATCH_SIZE=50
JXE_MQ_CONSUMER_NOTIFICATION_ENABLED=false
JXE_MQ_CONSUMER_PRINT_ENABLED=false
JXE_MQ_CONSUMER_CACHE_ENABLED=true
JXE_MQ_CONSUMER_SECURITY_ENABLED=false
JXE_MQ_CONSUMER_DISPATCH_ENABLED=true
JXE_MQ_DB_FALLBACK_ENABLED=true
JXE_MQ_FAIL_ON_TOPOLOGY_DRIFT=true

# 售后退款模块：酒票购买、续期和退款均依赖补偿退款执行能力。
JXE_AFTERSALE_ENABLED=false
JXE_REFUND_EXECUTION_ENABLED=false
JXE_REFUND_WORKER_ENABLED=true

# 酒票核心模块：总开关与业务分支默认关闭；启用前必须完成酒票数据库迁移。
# 购买对应酒票购买，核销对应线上酒柜提酒，转赠对应好友领取，提醒对应 T-7 和到期任务。
JXE_WINE_TICKET_ENABLED=false
JXE_WINE_TICKET_MAINTENANCE_OWNER=api
JXE_WINE_TICKET_PACKAGE_READ_ENABLED=false
JXE_WINE_TICKET_ADMIN_ENABLED=false
JXE_WINE_TICKET_PURCHASE_ENABLED=false
JXE_WINE_TICKET_REDEMPTION_ENABLED=false
JXE_WINE_TICKET_GIFT_ENABLED=false
JXE_WINE_TICKET_REMINDER_ENABLED=false
JXE_WINE_TICKET_WECHAT_REMINDER_ENABLED=false
JXE_WINE_TICKET_WECHAT_REMINDER_PROVIDER_ENABLED=false
JXE_WINE_TICKET_WECHAT_REMINDER_PRODUCT_NAME_FIELD=
JXE_WINE_TICKET_WECHAT_REMINDER_REMAINING_QUANTITY_FIELD=
JXE_WINE_TICKET_WECHAT_REMINDER_EXPIRY_DATE_FIELD=
JXE_WINE_TICKET_WECHAT_REMINDER_PAGE=
JXE_WINE_TICKET_RENEWAL_ENABLED=false
JXE_WINE_TICKET_REFUND_ENABLED=false
JXE_WINE_TICKET_RECONCILIATION_ENABLED=false
JXE_WINE_TICKET_RECONCILIATION_BATCH_SIZE=250
JXE_WINE_TICKET_RECONCILIATION_BATCH_INTERVAL=100ms
# 已完成日周期/其他实例持有租约时的最大 checkpoint 轮询间隔，不会触发全量重扫。
JXE_WINE_TICKET_RECONCILIATION_SWEEP_INTERVAL=15m
# 上海时间午夜后的启动偏移，必须早于 06:00。
JXE_WINE_TICKET_RECONCILIATION_DAILY_START=5m
JXE_WINE_TICKET_RECONCILIATION_LEASE_DURATION=5m
JXE_WINE_TICKET_GIFT_TOKEN_PEPPER=local_wine_ticket_gift_token_pepper_change_me
JXE_WINE_TICKET_QUOTE_TOKEN_SECRET=local_wine_ticket_quote_token_secret_change_me
JXE_WINE_TICKET_BACKFILL_ALLOW_WRITE=false

# 配送调度模块：控制订单派单任务、租约与失败重试。
JXE_DISPATCH_ENABLED=true
JXE_DISPATCH_WORKER_ENABLED=true
JXE_DISPATCH_MODE_OVERRIDE=
JXE_DISPATCH_WORKER_INTERVAL=1s
JXE_DISPATCH_WORKER_BATCH_SIZE=100
JXE_DISPATCH_LEASE_DURATION=15s
JXE_DISPATCH_JOB_TIMEOUT=5s
JXE_DISPATCH_MAX_ATTEMPTS=10
JXE_DISPATCH_HEARTBEAT_PERSIST_INTERVAL=30s

# 骑手路线规划模块：启用高德 Provider 时 JXE_MAP_ROUTE_AMAP_KEY 必填。
JXE_MAP_ROUTE_ENABLED=false
JXE_MAP_ROUTE_PROVIDER=amap
JXE_MAP_ROUTE_AMAP_BASE_URL=https://restapi.amap.com
JXE_MAP_ROUTE_TIMEOUT=5s
JXE_MAP_ROUTE_AMAP_KEY=

# 顾客定位 LBS 模块：observe/enforce 且使用高德时 JXE_C_LBS_AMAP_KEY 必填。
JXE_C_LBS_MODE=off
JXE_C_LBS_PROVIDER=amap
JXE_C_LBS_AMAP_KEY=
JXE_C_LBS_REGEOCODE_ENABLED=true
JXE_C_LBS_ROUTE_REFINE_ENABLED=true

# 腾讯云短信模块：本地 Mock 不需要凭据；生产环境必须填写全部腾讯云短信参数。
JXE_SMS_ENABLED=true
JXE_SMS_MOCK_ENABLED=true
JXE_SMS_PROVIDER=tencentcloud
JXE_SMS_TENCENTCLOUD_REGION=ap-guangzhou
JXE_SMS_TENCENTCLOUD_SECRET_ID=
JXE_SMS_TENCENTCLOUD_SECRET_KEY=
JXE_SMS_TENCENTCLOUD_SDK_APP_ID=
JXE_SMS_TENCENTCLOUD_SIGN_NAME=
JXE_SMS_TENCENTCLOUD_TEMPLATE_ID=
JXE_SMS_TENCENTCLOUD_ENDPOINT=sms.tencentcloudapi.com
JXE_SMS_HTTP_TIMEOUT=5s
