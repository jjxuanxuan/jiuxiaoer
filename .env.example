JXE_APP_ENV=local
JXE_INSTANCE_ID=local-api-1
JXE_SNOWFLAKE_NODE_ID=1
JXE_SNOWFLAKE_LEASE_TTL=30s
JXE_HTTP_ADDR=:8080
# Comma-separated ingress/load-balancer IPs or CIDRs. Empty disables trust in
# X-Forwarded-For/X-Real-IP and uses the direct peer address.
JXE_HTTP_TRUSTED_PROXIES=
JXE_HTTP_SHUTDOWN_TIMEOUT=10s
JXE_HTTP_READ_HEADER_TIMEOUT=5s
JXE_HTTP_READ_TIMEOUT=15s
JXE_HTTP_WRITE_TIMEOUT=30s
JXE_HTTP_IDLE_TIMEOUT=60s
JXE_HTTP_REQUEST_TIMEOUT=10s
JXE_HTTP_MAX_HEADER_BYTES=1048576
JXE_HTTP_MAX_BODY_BYTES=1048576

# MySQL DSN example:
# Keep the Go backend database isolated from the legacy Sequelize backend.
# user:password@tcp(127.0.0.1:3306)/jiuxiaoer_go_p0?charset=utf8mb4&parseTime=True&loc=Local
JXE_MYSQL_DSN='jxe_app:p0apppass@tcp(127.0.0.1:13306)/jiuxiaoer_go_p0?charset=utf8mb4&parseTime=True&loc=Local'
# Used only by migrations, seed and integration-test maintenance. Never use it for the API process.
JXE_MYSQL_MIGRATION_DSN='jxe:p0devpass@tcp(127.0.0.1:13306)/jiuxiaoer_go_p0?charset=utf8mb4&parseTime=True&loc=Local'
# Dedicated operator DSN for cmd/cp1-data. Keep unset on API/worker processes.
# Read-only DQ may fall back to JXE_MYSQL_DSN; writes never do.
JXE_CP1_DATA_DSN=
# A write also requires --execute and --confirm=APPLY_CP1_DATA_BACKFILL.
JXE_CP1_DATA_ALLOW_WRITE=false
JXE_MYSQL_REQUIRED=true
JXE_MYSQL_MAX_OPEN_CONNS=50
JXE_MYSQL_MAX_IDLE_CONNS=10
JXE_MYSQL_CONN_MAX_LIFETIME=30m
JXE_MYSQL_PING_TIMEOUT=3s

JXE_REDIS_ADDR=127.0.0.1:16379
JXE_REDIS_PASSWORD=
JXE_REDIS_DB=0
JXE_REDIS_REQUIRED=true
JXE_REDIS_PING_TIMEOUT=500ms

JXE_RABBITMQ_URL=amqp://jxe:p0devpass@127.0.0.1:5672/jxe-events-v2
JXE_RABBITMQ_MANAGEMENT_URL=http://127.0.0.1:15672/api
JXE_RABBITMQ_REQUIRED=true
JXE_RABBITMQ_DIAL_TIMEOUT=5s
JXE_RABBITMQ_RECONNECT_MIN=1s
JXE_RABBITMQ_RECONNECT_MAX=30s

JXE_JWT_ACCESS_SECRET=local_access_secret_change_me
JXE_JWT_REFRESH_SECRET=local_refresh_secret_change_me
JXE_JWT_ACCESS_TTL=2h
JXE_JWT_REFRESH_TTL=168h

JXE_ORDER_PAYMENT_TTL=15m
JXE_PAYMENT_CREATING_RECONCILE_AGE=30s
JXE_ORDER_EXPIRY_WORKER_ENABLED=true
JXE_ORDER_EXPIRY_SCAN_INTERVAL=10s
JXE_ORDER_EXPIRY_BATCH_SIZE=100
JXE_WECHAT_BILL_RECONCILIATION_ENABLED=false
JXE_WECHAT_BILL_RECONCILIATION_WORKER_ENABLED=true
JXE_WECHAT_BILL_RECONCILIATION_INTERVAL=30m
JXE_WECHAT_BILL_RECONCILIATION_RUN_HOUR=10
JXE_WECHAT_BILL_RECONCILIATION_LAG_DAYS=1
JXE_WECHAT_BILL_RECONCILIATION_START_DATE=
JXE_WECHAT_BILL_RECONCILIATION_BACKFILL_DAYS_PER_CYCLE=3
JXE_WECHAT_BILL_RECONCILIATION_REQUEST_TIMEOUT=5m
JXE_WECHAT_BILL_RECONCILIATION_INSERT_BATCH_SIZE=200
JXE_WECHAT_BILL_RECONCILIATION_RUNNING_TIMEOUT=30m
JXE_AFTERSALE_ENABLED=false
JXE_REFUND_EXECUTION_ENABLED=false
JXE_AFTERSALE_STANDARD_WINDOW=48h
JXE_AFTERSALE_UNOPENED_WINDOW=168h
JXE_AFTERSALE_PLATFORM_REVIEW_THRESHOLD=50000
JXE_REFUND_WORKER_ENABLED=true
JXE_REFUND_WORKER_INTERVAL=10s
JXE_REFUND_WORKER_BATCH_SIZE=50
JXE_EVIDENCE_TOKEN_SECRET=local_evidence_token_secret_change_me
JXE_ORDER_SERVICE_AREA_ENFORCEMENT=off
JXE_SERVICE_AREA_CACHE_TTL=10s
JXE_HOME_CACHE_TTL=1m
JXE_SERVICE_AREA_QUERY_TIMEOUT=200ms

JXE_WECHAT_AUTH_ENABLED=true
JXE_WECHAT_AUTH_MOCK_ENABLED=true
JXE_WECHAT_MINIAPP_ID=local-miniapp
JXE_WECHAT_MINIAPP_SECRET=
JXE_WECHAT_API_BASE_URL=https://api.weixin.qq.com
JXE_WECHAT_HTTP_TIMEOUT=5s

JXE_WECHAT_PAY_ENABLED=true
JXE_WECHAT_PAY_MOCK_ENABLED=true
JXE_WECHAT_PAY_MCH_ID=
JXE_WECHAT_PAY_CERT_SERIAL=
JXE_WECHAT_PAY_PRIVATE_KEY_PATH=
JXE_WECHAT_PAY_API_V3_KEY=
JXE_WECHAT_PAY_NOTIFY_URL=
JXE_WECHAT_REFUND_NOTIFY_URL=
JXE_WECHAT_PAY_DESCRIPTION=酒小二订单

JXE_ADMIN_BOOTSTRAP_PASSWORD=admin123
JXE_MERCHANT_BOOTSTRAP_PASSWORD=merchant123

JXE_PAYMENT_MOCK_ENABLED=true
JXE_SMS_ENABLED=true
# Local-only deterministic provider. Production must set this to false and
# configure the approved Tencent Cloud SMS application, sign, and template.
JXE_SMS_MOCK_ENABLED=true
JXE_SMS_PROVIDER=tencentcloud
JXE_SMS_TENCENTCLOUD_REGION=ap-guangzhou
JXE_SMS_TENCENTCLOUD_SECRET_ID=
JXE_SMS_TENCENTCLOUD_SECRET_KEY=
JXE_SMS_TENCENTCLOUD_SDK_APP_ID=
JXE_SMS_TENCENTCLOUD_SIGN_NAME=
JXE_SMS_TENCENTCLOUD_TEMPLATE_ID=
JXE_SMS_TENCENTCLOUD_ENDPOINT=sms.tencentcloudapi.com
JXE_SMS_HTTP_TIMEOUT=5s
JXE_ORDER_IDEMPOTENCY_ENABLED=true
JXE_STOCK_RESERVE_ENABLED=true

# Delivery incident reporting and operations. All switches default off; enable
# the fact write path before natural-close and notification side effects.
JXE_DELIVERY_INCIDENT_ENABLED=false
JXE_DELIVERY_INCIDENT_AUTO_RESOLVE_ENABLED=false
JXE_DELIVERY_INCIDENT_NOTIFICATION_ENABLED=false
# Empty allowlists mean no rollout. Use a single '*' (or 'all') for 100% rollout.
JXE_DELIVERY_INCIDENT_RIDER_ALLOWLIST=
JXE_DELIVERY_INCIDENT_SHOP_ALLOWLIST=
JXE_DELIVERY_INCIDENT_CREATE_RATE_PER_HOUR=20
JXE_DELIVERY_INCIDENT_EVIDENCE_RATE_PER_HOUR=30
JXE_DELIVERY_INCIDENT_CREATE_IP_RATE_PER_HOUR=100
JXE_DELIVERY_INCIDENT_EVIDENCE_IP_RATE_PER_HOUR=150
# Private media gateway contract. Both values must be set together; production/preprod requires HTTPS.
JXE_EVIDENCE_VIEW_BASE_URL=
JXE_EVIDENCE_VIEW_SECRET=
JXE_EVIDENCE_VIEW_TTL=5m

# Delivery return orchestration. Every switch is off by default. Enabling the
# master switch does not enable any write/approval/receipt side effect.
JXE_DELIVERY_RETURN_ENABLED=false
JXE_DELIVERY_RETURN_RIDER_WRITE_ENABLED=false
JXE_DELIVERY_RETURN_APPROVAL_ENABLED=false
JXE_DELIVERY_RETURN_RECEIPT_ENABLED=false
JXE_DELIVERY_RETURN_SYSTEM_AFTERSALE_ENABLED=false
JXE_DELIVERY_RETURN_NOTIFICATION_ENABLED=false
JXE_PAID_CANCEL_STOCK_DISPOSITION_ENABLED=false
JXE_DELIVERY_RETURN_RIDER_ALLOWLIST=
JXE_DELIVERY_RETURN_SHOP_ALLOWLIST=
JXE_DELIVERY_RETURN_HANDOFF_TTL=10m
JXE_DELIVERY_RETURN_RIDER_RATE_PER_10_MINUTES=10
JXE_DELIVERY_RETURN_SLA_WORKER_ENABLED=true
JXE_DELIVERY_RETURN_SLA_WORKER_INTERVAL=1m
JXE_DELIVERY_RETURN_SLA_WORKER_BATCH_SIZE=100
JXE_DELIVERY_RETURN_RECEIPT_REMINDER_AFTER=2h
JXE_DELIVERY_RETURN_RECEIPT_DEADLINE_AFTER=24h
JXE_MQ_PUBLISHER_ENABLED=false
# RabbitMQ Phase 1.5 backbone. JXE_MQ_PUBLISH_ENABLED supersedes the legacy
# publisher flag while the legacy name remains supported during rollout.
JXE_MQ_TOPOLOGY_VERSION=v1
JXE_MQ_PUBLISH_ENABLED=false
JXE_MQ_PUBLISHER_BATCH_SIZE=50
JXE_MQ_CONSUMER_NOTIFICATION_ENABLED=false
JXE_MQ_CONSUMER_PRINT_ENABLED=false
JXE_MQ_CONSUMER_CACHE_ENABLED=true
JXE_MQ_CONSUMER_SECURITY_ENABLED=false
JXE_MQ_CONSUMER_DISPATCH_ENABLED=true
JXE_MQ_CONSUMER_REALTIME_ENABLED=false
JXE_MQ_DB_FALLBACK_ENABLED=true
JXE_MQ_FAIL_ON_TOPOLOGY_DRIFT=false
# Independent deployment: outbox-publisher, mq-consumer-notification,
# mq-consumer-print, mq-consumer-cache, mq-consumer-security, mq-dead-sink, all.
JXE_WORKER_ROLE=all

# Hybrid dispatch. Payment success creates a dispatch job immediately; store
# preparation only opens the pickup gate.
JXE_DISPATCH_ENABLED=true
JXE_DISPATCH_WORKER_ENABLED=true
JXE_DISPATCH_MODE_OVERRIDE=
JXE_DISPATCH_WORKER_INTERVAL=1s
JXE_DISPATCH_WORKER_BATCH_SIZE=100
JXE_DISPATCH_LEASE_DURATION=15s
JXE_DISPATCH_JOB_TIMEOUT=5s
JXE_DISPATCH_MAX_ATTEMPTS=10
JXE_DISPATCH_HEARTBEAT_PERSIST_INTERVAL=30s

# Rider realtime dispatch. All realtime side effects stay disabled until the
# WebSocket client and rollout gates have been approved.
JXE_REALTIME_ENABLED=false
JXE_REALTIME_RELAY_ENABLED=false
JXE_REALTIME_TICKET_TTL=60s
JXE_REALTIME_HANDSHAKE_TIMEOUT=5s
JXE_REALTIME_HEARTBEAT_INTERVAL=25s
JXE_REALTIME_PONG_TIMEOUT=60s
JXE_REALTIME_SESSION_CHECK_INTERVAL=60s
JXE_REALTIME_SHUTDOWN_DRAIN_TIMEOUT=5s
JXE_REALTIME_RELAY_INTERVAL=1s
JXE_REALTIME_DELIVERY_RETENTION=168h
JXE_REALTIME_ACK_RETENTION=720h
JXE_REALTIME_MAX_CONNECTIONS_PER_RIDER=3
JXE_REALTIME_SEND_QUEUE_SIZE=32
JXE_REALTIME_MAX_FRAME_BYTES=8192
JXE_REALTIME_RESUME_LIMIT=100
JXE_REALTIME_RELAY_BATCH_SIZE=100
JXE_REALTIME_ALLOWED_ORIGINS=
JXE_REALTIME_CANARY_RIDER_IDS=
JXE_REALTIME_TICKET_RIDER_RATE_PER_MINUTE=10
JXE_REALTIME_TICKET_IP_RATE_PER_MINUTE=30
JXE_REALTIME_HANDSHAKE_IP_RATE_PER_MINUTE=60
JXE_REALTIME_ACK_RATE_PER_MINUTE=120
JXE_REALTIME_RESUME_RATE_PER_MINUTE=6

# Delivery route planning. Disabled by default; no real Amap key belongs in
# source control. The fake provider is only for local contract testing.
JXE_MAP_ROUTE_ENABLED=false
JXE_MAP_ROUTE_PROVIDER=fake
JXE_MAP_ROUTE_AMAP_BASE_URL=https://restapi.amap.com
JXE_MAP_ROUTE_AMAP_KEY=
JXE_MAP_ROUTE_MODE=electric_bicycle
JXE_MAP_ROUTE_STRATEGY=default
JXE_MAP_ROUTE_TIMEOUT=1500ms
JXE_MAP_ROUTE_CACHE_TTL=60s
JXE_MAP_ROUTE_STALE_TTL=10m
JXE_MAP_ROUTE_LOCATION_FRESHNESS=120s
JXE_MAP_ROUTE_MAX_ACCURACY_M=200
JXE_MAP_ROUTE_RIDER_RATE_PER_MINUTE=20
JXE_MAP_ROUTE_ACCOUNT_RATE_PER_MINUTE=30
JXE_MAP_ROUTE_IP_RATE_PER_MINUTE=60
JXE_MAP_ROUTE_MAX_CONCURRENCY=50
JXE_MAP_ROUTE_CANARY_RIDER_IDS=
JXE_MAP_ROUTE_CACHE_HMAC_SECRET=local_map_route_hmac_secret_change_me

# Customer-facing LBS. Keep this key separate from rider route planning so
# anonymous resolve traffic cannot exhaust the fulfilment navigation quota.
JXE_C_LBS_MODE=off
JXE_C_LBS_PROVIDER=amap
JXE_C_LBS_AMAP_BASE_URL=https://restapi.amap.com
JXE_C_LBS_AMAP_KEY=
JXE_C_LBS_REGEOCODE_ENABLED=false
JXE_C_LBS_ROUTE_REFINE_ENABLED=false
JXE_C_LBS_CONTEXT_TTL=10m
JXE_C_LBS_REGEOCODE_TIMEOUT=2s
JXE_C_LBS_ROUTE_TIMEOUT=2s
JXE_C_LBS_RESOLVE_TIMEOUT=3s
JXE_C_LBS_REGEOCODE_FRESH_TTL=6h
JXE_C_LBS_REGEOCODE_STALE_TTL=168h
JXE_C_LBS_ROUTE_FRESH_TTL=5m
JXE_C_LBS_ROUTE_STALE_TTL=30m
JXE_C_LBS_MAX_ROUTE_CANDIDATES=3
JXE_C_LBS_MAX_ACCURACY_M=200
JXE_C_LBS_MAX_CONCURRENCY=50
JXE_C_LBS_ANONYMOUS_IP_RATE=30
JXE_C_LBS_CUSTOMER_RATE=20
JXE_C_LBS_SESSION_RATE=10
JXE_C_LBS_ALLOWED_ORIGINS=
JXE_C_LBS_CACHE_HMAC_SECRET=local_customer_lbs_hmac_secret_change_me
JXE_C_LBS_SESSION_HEADER=X-Session-ID

# C-end customer search discovery. Guests may read hot keywords but never
# contribute to history or ranking statistics.
JXE_SEARCH_HISTORY_MAX=20
JXE_SEARCH_HISTORY_RETENTION=4320h
JXE_SEARCH_HOT_WINDOW_DAYS=7
JXE_SEARCH_STATS_RETENTION_DAYS=30
JXE_SEARCH_HOT_CACHE_TTL=5m
JXE_SEARCH_EVENT_RATE_LIMIT=30
JXE_SEARCH_CLEANUP_ENABLED=true
JXE_SEARCH_CLEANUP_INTERVAL=24h
JXE_SEARCH_CLEANUP_BATCH_SIZE=1000

# 骑手申请入驻（默认关闭；启用时 MySQL 与 Redis 必须可用）
JXE_RIDER_APPLICATION_ENABLED=false
JXE_RIDER_APPLICATION_TOKEN_TTL=30m
JXE_RIDER_APPLICATION_HMAC_SECRET=local_rider_application_hmac_secret_change_me
JXE_RIDER_APPLICATION_MAX_SHOPS=50
JXE_RIDER_APPLICATION_SUBMIT_IP_RATE_PER_HOUR=10
JXE_RIDER_APPLICATION_SUBMIT_PHONE_RATE_PER_DAY=3
JXE_RIDER_APPLICATION_LOGIN_IP_RATE_PER_MINUTE=30
JXE_RIDER_APPLICATION_LOGIN_PHONE_RATE_PER_15_MINUTES=10
JXE_RIDER_APPLICATION_WRITE_ACCOUNT_RATE_PER_MINUTE=10
JXE_RIDER_APPLICATION_RESUBMIT_ACCOUNT_RATE_PER_DAY=3
JXE_RIDER_APPLICATION_REVIEW_ADMIN_RATE_PER_MINUTE=60

JXE_METRICS_ENABLED=true
# Production requires a non-empty bearer token with at least 16 characters.
JXE_METRICS_TOKEN=
# L4 member and asset ledger (production defaults remain disabled)
JXE_MEMBER_ENABLED=false
JXE_ASSET_READ_ENABLED=false
JXE_ASSET_WRITE_ENABLED=false
JXE_COMPENSATION_ISSUE_ENABLED=false
JXE_ASSET_EXPIRY_ENABLED=false
JXE_ASSET_REPAIR_ENABLED=false
JXE_ASSET_WORKER_ENABLED=true
JXE_ASSET_WORKER_INTERVAL=10s
JXE_ASSET_WORKER_BATCH_SIZE=100

# CP1 launch closure. Keep the release profile off for local development and
# ordinary/degraded production operation. Set phase_one only with
# JXE_APP_ENV=production on a candidate that must fail startup/readiness when any
# required capability is off.
JXE_CP1_RELEASE_PROFILE=off
JXE_CP1_PRINT_ENABLED=false
JXE_CP1_NOTIFICATION_ENABLED=false
JXE_CP1_PROVISIONING_ENABLED=true
JXE_CP1_FORCE_ACTION_ENABLED=false
JXE_CP1_PICKUP_VERIFICATION_MODE=observe
JXE_CP1_DELIVERY_VERIFICATION_MODE=observe
JXE_CP1_COMPLIANCE_MODE=observe
JXE_CP1_PRINT_PROVIDER=fake
JXE_CP1_NOTIFICATION_PROVIDER=fake
JXE_CP1_IDENTITY_PROVIDER=fake
JXE_CP1_WORKER_ENABLED=true
JXE_CP1_WORKER_INTERVAL=2s
JXE_CP1_WORKER_BATCH_SIZE=50
JXE_CP1_VERIFICATION_TTL=30m
JXE_CP1_DELIVERY_VERIFICATION_TTL=2h
JXE_CP1_DELIVERY_VERIFICATION_MAX_TTL=6h
JXE_CP1_VERIFICATION_MAX_ATTEMPTS=5
JXE_CP1_VERIFICATION_LOCK_DURATION=15m
JXE_CP1_VERIFICATION_PEPPER=local_verification_pepper_change_me
JXE_CP1_IDENTITY_CALLBACK_SECRET=local_identity_callback_secret_change_me
JXE_CP1_DATA_ENCRYPTION_KEY=local_data_encryption_key_change_me
